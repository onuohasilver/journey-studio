{
  "name": "journey-studio",
  "version": "0.1.0",
  "description": "A visual canvas for building, running and replaying API journeys — chains of HTTP calls where the ids and tokens each step produces flow into the next.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "openapi",
    "http",
    "testing",
    "workflow",
    "integration-testing",
    "api-client"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@xyflow/react": "^12.3.0",
    "express": "^4.21.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
